# Public browser configuration (safe to ship in the frontend; access is enforced by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side rendering (same public values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# PRIVATE, server-only. Do not put a real value in any env file; set it in the
# server process environment or a secret manager. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
